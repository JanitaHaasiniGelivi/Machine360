# MachineMind 360 - Backend Environment Configuration

# Application
PROJECT_NAME="MachineMind 360"
ENVIRONMENT=development
DEBUG=false
# Only enable demo fixtures explicitly during local development.
SEED_DEMO_DATA=false

# Security
SECRET_KEY=machinemind360-replace-with-secure-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Local SQLite mode:
DATABASE_URL=sqlite:///./machinemind360.db
# Production PostgreSQL mode:
# DATABASE_URL=postgresql://user:password@localhost:5432/machinemind360

# CORS Allowed Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ML Artifacts Directory Path
ML_ARTIFACTS_DIR=artifacts
